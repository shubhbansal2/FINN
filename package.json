{
  "name": "finn",
  "version": "0.1.0",
  "private": true,
  "description": "FINN — mobile-first investment intelligence for an Indian equity portfolio",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "finn": "tsx --tsconfig tsconfig.json scripts/finn.ts",
    "test:e2e": "playwright test",
    "setup:demo": "npm run finn -- universe:sync && npm run finn -- ingest:prices && npm run finn -- ingest:filings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "better-sqlite3": "11.10.0",
    "cheerio": "1.2.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

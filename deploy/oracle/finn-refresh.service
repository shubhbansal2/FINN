[Unit]
Description=FINN live data refresh (end-of-day prices, exchange filings, results figures and management changes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finn
Group=finn
WorkingDirectory=/opt/finn
EnvironmentFile=/etc/finn/finn.env
ExecStart=/usr/bin/npm run finn -- ingest:prices
ExecStart=/usr/bin/npm run finn -- ingest:filings
ExecStart=/usr/bin/npm run finn -- ingest:results
ExecStart=/usr/bin/npm run finn -- ingest:people
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/finn

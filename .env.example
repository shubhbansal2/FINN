# Copy to .env and fill in. Never commit .env.

# `fixture` (default): recorded provider responses only; every record is labelled demo data.
# `live`: real calls to Yahoo Finance and screener.in, and document downloads from BSE / company sites.
# Each mode has its own database file, so demo and live data never mix.
FINN_DATA_MODE=fixture

# Where the SQLite database and downloaded documents are stored.
# Keep this outside cloud-synced folders (OneDrive, Dropbox): SQLite WAL files do not sync safely.
FINN_DATA_DIR=data

# Demo mode only: the fixed "now" signal windows and alerts are measured from, so recorded
# fixtures stay inside their windows. Shown on the Signals page as the demo clock.
FINN_DEMO_NOW=2026-11-01T10:30:00.000Z

# Optional. A model enables the model-assisted research modules (statement filtering, written
# overview, bull/bear, question answering). Without one they fall back to deterministic,
# clearly labelled output. Keys are read only on the server.
#
# `gemini`, `anthropic`, or `auto` (default): Anthropic if ANTHROPIC_API_KEY is set, else Gemini.
FINN_LLM_PROVIDER=gemini

# Google Gemini (free tier): create a key at https://aistudio.google.com/apikey
# Free-tier inputs may be used by Google to improve its products; FINN sends public filings
# and your research question, nothing else. Free-tier rate limits apply per Google project.
GEMINI_API_KEY=
# Optional Gemini model overrides (must support thinking levels).
# FINN_GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# gemini-3.8-flash is newer but returned 503 / no response when tested on 2 Nov 2026.
# FINN_GEMINI_MODEL_SYNTHESIS=gemini-3.6-flash

# Anthropic Claude (paid API).
ANTHROPIC_API_KEY=
# Optional Claude model overrides.
# FINN_MODEL_EXTRACTION=claude-haiku-5-5
# FINN_MODEL_SYNTHESIS=claude-opus-5-5

# Exposes /dev/design-system in production builds. It is always available in `next dev`.
# The page shows clearly labelled specimen values only, never market data.
FINN_ENABLE_DEV_ROUTES=false
